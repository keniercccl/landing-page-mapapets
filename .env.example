VITE_GOOGLE_FORM="https://docs.google.com/forms/d/e/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/viewform"

# La galeria de Flickr ya no usa variables VITE_ (se exponian en el bundle
# publico). Ahora las lee api/flickr.js del lado del servidor. Configuralas
# en Vercel -> Settings -> Environment Variables, SIN prefijo VITE_:
#   FLICKR_API_KEY=your_flickr_api_key
#   FLICKR_ALBUM_ID=your_flickr_album_id

# Meta Pixel (Meta Business Manager -> Administrador de eventos -> Web)
